{
	"name": "abcjs-editor",
	"version": "1.1.0",
	"description": "Simple visual editing of ABC strings",
	"author": "Paul Rosen",
	"copyright": "Copyright © 2018-2026 by Paul Rosen",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"dev-cache": "rm -R node_modules/.cache/vite && nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"ghpages": "nuxt build --preset github_pages",
		"postghpages": "npx serve .output/public",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"dependencies": {
		"@pinia/nuxt": "^1.0.3",
		"@webcoder49/code-input": "^2.8.3",
		"abcjs": "^6.7.0",
		"highlight.js": "^11.11.1",
		"highlightjs-abc": "https://github.com/paulrosen/highlightjs-abc.git#0dff0ab12ad49a365163e527f05ed62d06f3fdf6",
		"nuxt": "^4.6.2"
	},
	"devDependencies": {
		"@nuxt/eslint": "^1.12.1",
		"@nuxtjs/google-fonts": "^3.2.0",
		"eslint": "^10.13.0",
		"vite-plugin-eslint2": "^5.0.4"
	},
	"overrides": {
		"glob": "^13.0.6"
	},
	"allowScripts": {
		"@parcel/watcher@2.5.6": true,
		"unrs-resolver@1.12.2": true,
		"esbuild@0.28.2": true
	}
}
